	quest.2165E80C52C79992.title: "&9重要按键"
	quest.221923EEDAEE1BEE.quest_subtitle: "&e太阳之灵&r是&6黄金地牢&r里的 Boss。"
	quest.2252ACBB97526BB2.quest_subtitle: "把所有相邻的容器连成一个整体，范围最远 16 格。用&6存储终端&7即可访问你的全部物品。"
	quest.2252ACBB97526BB2.title: "合成&3库存连接器"
	quest.23B2A759FBB4DBFF.quest_desc: ["&8永晨之地&r的太阳永远在升起。这个世界更加湿热，昆虫与爬行动物在此繁盛。进去之前值得备好解毒和抗火手段，这里很多地方都会让你中毒或者着火。"]
	quest.23B2A759FBB4DBFF.quest_subtitle: "传送门方块可以在守门人之家的里面或外面找到。"
	quest.23B2A759FBB4DBFF.title: "进入&8永晨之地"
	quest.24AFBFE4670B5FC1.quest_subtitle: "把&c&l绯红蚊幼虫&r放进&5衣壳&r里，再把神秘幼虫扔进&5&l末地&r的虚空中。"
	quest.24AFBFE4670B5FC1.title: "召唤并击败&9虚空蠕虫"
	quest.2574E7CF699D5B45.quest_subtitle: "用斧头砍断一根原木，整棵树都会跟着倒下。潜行时砍则不会触发。"
	quest.2574E7CF699D5B45.title: "获得&a原木"
	quest.264FA27F45BDDCFF.quest_subtitle: "击杀沼泽迷宫里的牛头人可以获得。解锁空心山。"
	quest.264FA27F45BDDCFF.title: "吃下哞肉炖菜"
	quest.26EA75D177BC496B.quest_subtitle: "和原版一样，击杀袭击队长就会触发袭击"
	quest.26EA75D177BC496B.title: "保卫村庄，击退&4袭击"
	quest.27CD46C8E6EC2E3B.quest_desc: ["永明之地是一片永昼而酷寒的领域，栖息着巨兽与缥缈的生灵，穿行其间时务必留意背后。尤其当心暴风雪——它会带来浓雾，以及比平时多得多的敌人。"]
	quest.27CD46C8E6EC2E3B.quest_subtitle: "传送门方块可以在守门人之家的里面或外面找到。"
	quest.27CD46C8E6EC2E3B.title: "进入&9永明之地"
	quest.2802A4603874C24B.title: "合成&d书桌"
	quest.283303A94E452303.quest_subtitle: "和&3存储终端&r功能相同，只是&9存储请求台&r自带一个工作台，合成更方便。"
	quest.283303A94E452303.title: "合成&9存储请求台"
	quest.2958CA7FA6FD3E4F.quest_desc: [
		"屏幕左上角那个图标是&aFTB 队伍&r菜单，可以把其他玩家拉进你的队伍。"
		""
		"&aFTB 队伍&r图标右边是&6任务书&r图标，随时点开都能查看&6任务书&r。"
		""
		"想打开&8饰品&r栏位，点击背包里人物模型右上角的&8饰品&r按钮。"
		""
		"试试把任务奖励里的&6提灯&r装进饰品腰带栏位！"
	]
	quest.2958CA7FA6FD3E4F.quest_subtitle: "请阅读我的描述！"
	quest.2958CA7FA6FD3E4F.title: "&2背包"
	quest.2A1BA4AAA2162ECE.quest_subtitle: "[\"\",{\"text\":\"把\"},{\"text\":\"终端\",\"color\":\"dark_aqua\"},{\"text\":\"的可用距离延长 16 格。按\",\"color\":\"gray\"},{\"keybind\":\"key.toms_storage.open_terminal\",\"color\":\"aqua\"},{\"text\":\"即可快捷打开终端。\"}]"
