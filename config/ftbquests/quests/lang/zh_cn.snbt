	file.0000000000000001.title: "Better MC [NEOFORGE] 1.21.1"
	quest.0014F34081D341EB.quest_subtitle: "用来让村民转职成&c探险家&r，他出售通往各种建筑的地图，也会用绿宝石收购空白地图。"
	quest.0014F34081D341EB.title: "获得&e饰纹陶罐"
	quest.009EC4156DE356FD.quest_subtitle: "让你在&l任意&r两地之间轻松往返。传送距离越远，可能消耗越多&a经验&r。"
	quest.009EC4156DE356FD.title: "获得&6传送石碑"
	quest.01310D75B641BFB8.title: "&5史诗握寿司"
	quest.0172BB881A7259C8.title: "合成&d木长椅"
	quest.01B8CE5F95F0B5D2.quest_subtitle: "[\"\",{\"text\":\"装备到\"},{\"text\":\"箭袋\",\"color\":\"gold\"},{\"text\":\"栏位即可随时取用。在背包里选中一支箭，右键点进\"},{\"text\":\"箭袋\",\"color\":\"gold\"},{\"text\":\"就能存进去。按\"},{\"keybind\":\"supplementaries.keybind.quiver\",\"color\":\"aqua\"},{\"text\":\"可以远程打开\"},{\"text\":\"箭袋\",\"color\":\"gold\"},{\"text\":\"，用滚轮切换箭矢。使用弓、弩这类消耗箭矢的武器时，会优先射出选中的那支箭。\"}]"
	quest.01B8CE5F95F0B5D2.title: "获得&6箭袋"
	quest.01D0C8DB2646FFC9.title: "合成&d橱柜"
	quest.02123DF44B4B6CBC.quest_subtitle: "在某些建筑里能找到。相当于&e防火&r的&d潜影盒&r升级版，&7&l保险箱&r还可以用钥匙上锁。"
	quest.02123DF44B4B6CBC.title: "找到&7&l保险箱"
	quest.0357FE0F3A96B787.quest_subtitle: "任何中等体型的生物都能装进&8笼子&r。右键释放，潜行点击方块可以把&8笼子&r放下。关在笼子里的鸡照样会下蛋。"
	quest.0357FE0F3A96B787.title: "合成&5笼子"
	quest.038B71E71E3C8213.quest_subtitle: "&e女武神&r是靠战斗证明自己的&e中立生物&r。不主动攻击，除非你先动手；只出现在&8银色地牢&r里。"
	quest.04A9E3C00BC94C02.quest_subtitle: "让鱼跑不掉！"
	quest.051732AE45671DB5.quest_subtitle: "用来让村民转职成&6猎人&r，他出售黏液球、岩浆膏以及通往前哨站的地图。"
	quest.051732AE45671DB5.title: "合成&5狩猎站"
	quest.056000388DAD3E1B.quest_subtitle: "用来把网络核心连到箱子、木桶这类储物方块上。连接大箱子时注意只接一根线缆，不要给每半个箱子各接一根。"
	quest.056000388DAD3E1B.title: "合成&d连接线缆"
	quest.056502387B06B743.quest_subtitle: "只要走上&d传送板&r就会被传送到设定好的目的地。用来把生物运到很远的地方尤其好使。"
	quest.056502387B06B743.title: "合成&d传送板"
	quest.057F24FB4A75A4A5.quest_subtitle: "让绿叶甜蜜点随机出现！"
	quest.061738850E42D99B.quest_subtitle: "体型很小的生物可以装进&f罐子&r。右键释放，潜行点击方块可以把&f罐子&r放下。"
	quest.061738850E42D99B.title: "合成&f罐子"
	quest.0653401A7B3A8EDC.quest_subtitle: "整套存储系统的根基。请求台必须紧贴网络核心，所有储物方块都要用线缆连到核心上。一套系统只能有一个核心。"
	quest.0653401A7B3A8EDC.title: "合成&c存储网络核心"
	quest.084BFF7D3DD9BB24.quest_desc: ["召唤师会用闪电、能量攻击以及他的傀儡卫兵作战。小心背后——这些傀儡要是不及时处理，很快就会把你淹没。击败他之后就能进入自然地牢。"]
	quest.084BFF7D3DD9BB24.quest_subtitle: "用钥匙传送到&5召唤师地牢&r，入口在致盲地牢的顶层。"
	quest.084BFF7D3DD9BB24.title: "击败&5召唤师"
	quest.09919A0C03840EA7.quest_subtitle: "装备到&e手腕栏位&r后，屏幕上会一直显示当前的世界时间。"
	quest.09919A0C03840EA7.title: "合成&6时钟"
	quest.0A99C7852725BFC2.quest_subtitle: "&e青铜地牢&r的入口开在普通岛屿的侧面，房间数量不固定。非 Boss 房里有会主动攻击玩家的&c&l哨兵&r&r，有时还有摆在 4x4 桌子上的箱子——不过其中一些其实是&c宝箱怪&r。这里的&9Boss&r不吃剑伤，但任何工具（&a镐&r、&a锹&r 等）都能打掉它的血。每个前厅地板上都有&c9 个方块&r完全挖不动，&cBoss 房&r的墙壁也只有在&cBoss&r死后才挖得开。"
	quest.0BFD8ED8A0E3AE60.quest_subtitle: "把四块灵魂沙摆成 \"T\" 形，再在顶上那排的三个方块上各放一个凋灵骷髅头颅，就能召唤出凋灵。"
	quest.0BFD8ED8A0E3AE60.title: "击败&8&l凋灵"
	quest.0E349CAEF1D249B6.quest_subtitle: "&b滑块&r是&e青铜地牢&r里的 Boss。"
	quest.0EDB1E145CB2D26F.quest_subtitle: "看起来这里还没有人。至少这些漂亮的门你可以随便用。"
	quest.0EDB1E145CB2D26F.title: "前往&f&l终末城堡"
	quest.0F4154714C10CACE.quest_subtitle: "让穿戴者永久获得&3迅捷&r效果"
	quest.0F4154714C10CACE.title: "合成&3监守者护腿"
	quest.100082345FA03A9B.quest_subtitle: "&c哨兵&r是&e青铜地牢&r里的&4敌对生物&r"
	quest.119D3352DF35D3F3.quest_subtitle: "用来让村民转职成&a花匠&r，他出售蜜脾，以及通往沼泽和丛林的地图。"
	quest.119D3352DF35D3F3.title: "合成&f园艺台"
	quest.123097813B579C3E.quest_subtitle: "功能和&3存储终端&7一样，但自带一个合成格。"
	quest.123097813B579C3E.title: "合成&6合成终端"
	quest.139DAA6E8CF4267A.quest_desc: [
		"你可能已经注意到背包下方有一个搜索栏。"
		""
		"这是&d物品管理器&r（&dJEI&r）的搜索栏。"
		""
		"在搜索栏里打字，就会筛选出符合关键词的物品。"
		""
		"比如输入&e木&r，屏幕右侧的&dJEI&r物品列表就会列出所有名称或提示文本里带&e木&r的物品。"
		""
		"搜索&eSlot: Wrist&r会列出所有能放进手腕饰品栏的物品。"
		""
		"在搜索词前加上&c@&r可以只看某个模组的物品，例如&e@Handcrafted&r"
		""
		"也可以按物品标签搜索，比如&e#Wood&r会列出所有带&e木头标签&r的物品。"
		""
		"[\"\",{\"text\":\"想收藏某个物品，把鼠标移到\"},{\"text\":\"JEI\",\"color\":\"light_purple\"},{\"text\":\"物品列表里的它上面，按\"},{\"keybind\":\"key.jei.bookmark\",\"color\":\"aqua\"},{\"text\":\"。\"}]"
	]
	quest.139DAA6E8CF4267A.quest_subtitle: "请阅读我的描述！"
	quest.139DAA6E8CF4267A.title: "&b物品管理器（JEI）"
	quest.13B914EA3AE61CFA.title: "合成&d置物架"
	quest.175099CF5696829E.quest_desc: [
		"&9任务目标&r是完成一个任务需要做的事。如果目标是某个物品，点击它就能看到合成配方。"
		""
		"&6奖励&r是完成全部&9任务目标&r之后能拿到的东西，点击即可领取。"
		""
		"右上角的图钉图标可以把任务钉在屏幕上。"
	]
	quest.175099CF5696829E.quest_subtitle: "请阅读我的描述！"
	quest.175099CF5696829E.title: "&6任务"
	quest.17EE59DC9B0C44B7.quest_desc: ["星辉碎裂者移动不多，但它会把根扎进地里，从地下发动大范围攻击，力量之大足以让整片地面震颤。说到底它还是棵树，所以斧头对它的伤害高得多，也只有斧头能破开它的防御。留意用长矛把它击晕的机会，那就是你的输出窗口。"]
	quest.17EE59DC9B0C44B7.quest_subtitle: "用钥匙打开通往&c星辉碎裂者&r的大门，位置在&a自然地牢&r的顶层"
	quest.17EE59DC9B0C44B7.title: "击败&c星辉碎裂者"
	quest.17EFC9B9E98AA2FC.quest_subtitle: "在修道院里，那是一种生成于&b冰封山峰&r生物群系的建筑"
	quest.17EFC9B9E98AA2FC.title: "击败&a雕刻家·铜臂"
	quest.183F0FF4EE024A6D.quest_subtitle: "用来让村民转职成&a林务员&r，他出售各种各样的原木。"
	quest.183F0FF4EE024A6D.title: "合成&2林业工作台"
	quest.192EE909C57F390A.quest_subtitle: "打破&8远古花瓶&r后有小概率刷出。"
	quest.192EE909C57F390A.title: "击败&3潜行者"
	quest.1A16AF04EC133432.quest_subtitle: "带护甲的&6鞘翅，不用烟花火箭也能加速。"
	quest.1A16AF04EC133432.title: "合成&1灵魂鞘翅"
	quest.1A93E0B7C2A429D2.quest_subtitle: "可以把&c染&a过&e色&b的&r物品洗回原色、把&6铜块&r擦干净、给羊&c洗&a掉&e颜&b色&r，还能把&2粘性&r活塞变回普通活塞。"
	quest.1A93E0B7C2A429D2.title: "合成&d肥皂"
	quest.1ABA46B046733CA1.quest_subtitle: "巨型火把的三个变种之一。在水平半径 64 格、垂直半径 32 格的范围内阻止怪物生成。"
	quest.1ABA46B046733CA1.title: "合成&b钻石巨型火把"
	quest.1C2C225F714DCE25.quest_subtitle: "额外增加一个发光甜蜜点！"
	quest.1C4F04EF71998F25.quest_subtitle: "在灵魂铁匠铺里，这种建筑在&c下界&r极少出现。用&c狰狞之眼&r定位"
	quest.1C4F04EF71998F25.title: "击败&8下界合金怪物"
	quest.1D586D16999169B8.title: "&6稀有握寿司"
	quest.1D931A64546B3449.quest_subtitle: "在沙漠里用刷子刷可疑的沙子就能挖出来。"
	quest.1D931A64546B3449.title: "挖出&e沙漠项链"
	quest.1E719BE1002F0855.quest_desc: [
		"在&eBetter Minecraft&r里，&2村民&r的行为有不少改动："
		""
		"- 手里拿着&a&l绿宝石块&r时，他们会跟着你走。"
		""
		""
		"- 只要&b村庄&r里还有空床，喂任何食物（包括模组食物）都能让&2村民&r繁殖。"
		""
		""
		"- &6农民村民&r补种作物时聪明多了，会考虑刚才收了什么、附近种着什么。"
		"他们也会种模组作物。"
		""
		""
		"- 每个村民都有自己的名字，显示在头顶上。"
		""
		""
		"由于&2村民&r行为的这些改动，很多依赖村民的自动化农场都无法正常工作。"
		""
		""
		"&b村庄&r本身也有一些变化："
		""
		"- 不再生成在山坡或其它起伏不平的地形上。也就是说，你更容易在平地上找到&b村庄&r。"
		""
		""
		"- 现在沼泽、丛林以及&e&l天境&r维度里也会生成村庄。"
		""
		""
		"- &4袭击&r中出现了许多新敌人。如果袭击快结束时找不到最后一个敌人，敲钟可以把它高亮标出来。"
	]
	quest.1E719BE1002F0855.quest_subtitle: "请阅读我的描述！"
	quest.1E719BE1002F0855.title: "观察&2村民"
	quest.204EEC01F998DDB6.quest_subtitle: "在&6&l远古工厂&r里，这种建筑生成于洞穴中。用&6机械之眼&r定位"
	quest.204EEC01F998DDB6.title: "击败&4先驱者"
	quest.207769EC3251F70E.quest_subtitle: "藏在自然地牢里。"
	quest.207769EC3251F70E.title: "收集 4 把&a地牢钥匙"
	quest.2165E80C52C79992.quest_desc: [
		"[\"\",{\"text\":\"把鼠标移到物品上按\"},{\"keybind\":\"key.jei.showRecipe\",\"color\":\"aqua\"},{\"text\":\"，查看它的合成配方\"}]"
		""
		"[\"\",{\"text\":\"把鼠标移到物品上按\"},{\"keybind\":\"key.jei.showUses\",\"color\":\"aqua\"},{\"text\":\"，查看它的用途\"}]"
		""
		"[\"\",{\"text\":\"潜行时空手按\"},{\"keybind\":\"key.use\",\"color\":\"aqua\"},{\"text\":\"可以举起方块（搬箱子很好用，但不是所有方块都能搬）\"}]"
		""
		"[\"\",{\"text\":\"按\"},{\"keybind\":\"key.clientsort.op.sort\",\"color\":\"aqua\"},{\"text\":\"整理物品（背包、箱子等）\"}]"
		""
		"[\"\",{\"text\":\"使用带连锁挖掘附魔的工具时按住\"},{\"keybind\":\"key.veinmining.activate.desc\",\"color\":\"aqua\"},{\"text\":\"，即可触发连锁挖掘（如果显示「未绑定」，先到 选项 → 控制 → 按键绑定 里给「连锁采集」下的「激活」设一个键）\"}]"
		""
		"[\"\",{\"text\":\"按\"},{\"keybind\":\"gui.xaero_open_map\",\"color\":\"aqua\"},{\"text\":\"打开世界地图\"}]"
		""
		"输入&b/yigd grave&r查看自己的死亡记录"
		""
		"[\"\",{\"text\":\"按\"},{\"keybind\":\"gui.xaero_pac_key_open_menu\",\"color\":\"aqua\"},{\"text\":\"打开领地声明界面\"}]"
		""
		"[\"\",{\"text\":\"按\"},{\"keybind\":\"justzoom.keybinds.keybind.zoom\",\"color\":\"aqua\"},{\"text\":\"缩放视野\"}]"
		""
		"[\"\",{\"text\":\"按\"},{\"keybind\":\"key.pingwheel.ping_location\",\"color\":\"aqua\"},{\"text\":\"标记位置\"}]"
	]
