	task.21428FE253D34D4E.title: "任务"
	task.2498701E7715A09B.title: "击败&e太阳鸟·乌姆武提"
	task.2A41742198B4693C.title: "击杀末影守卫"
	task.2AF8CE4F7464FE5C.title: "击杀炼金术士"
	task.2F88DFAD11A0FFA5.title: "进入永晨之地"
	task.320E04AD2AD28E79.title: "击杀可怖恶魂"
	task.3333928391216A43.title: "击败&7铁锻魔"
	task.3363067332FD6A6A.title: "击杀伊格尼斯"
	task.343A102078E26613.title: "任意 #accessories:shulker"
	task.34BEAE9F7B3C7641.title: "进入永明之地"
	task.37E411F497C9CD71.title: "击杀监守者"
	task.3865A3E4D4A9A5F3.title: "造访&e青铜地牢"
	task.38FCC3D73DBE7CA4.title: "击败&b玛勒迪克特"
	task.39A27C60C2775BD5.title: "击败&c幻术师"
	task.3B2CC7DEE30E3AB8.title: "&a教程完成！"
	task.3D7BD985875AFF57.title: "击杀尖啸蠕虫"
	task.412B85684482E982.title: "击杀末影龙"
	task.4145F5BE1E32262B.title: "任意 #minecraft:logs"
	task.444AC080F3243355.title: "进入末地维度"
	task.44740305C2A8DC52.title: "合成背包"
	task.474D2D76F2256297.title: "进入彼岸"
	task.4937B6F09587F4C9.title: "击败&c哨兵"
	task.49A00D8BAA0923BD.title: "击败&e太阳之灵"
	task.4B0CA66749CB35C7.title: "击败&6远古遗孽"
	task.4CE4CD701A07CA04.title: "击杀燃烧亡魂"
	task.4DBC642134268AE7.title: "击杀下界合金怪物"
	task.563B156CBD2C299A.title: "击败&6燃烧亡魂"
	task.575C8BC94DAC2B05.title: "击杀凋灵"
	task.5B9501581479A2EC.title: "击杀碎裂者"
	task.60D9ED81B17CAE0F.title: "击杀末影傀儡"
	task.648F394BA53947B6.title: "击败&b霜颚"
	task.679295C74DF4AA03.title: "召唤并击杀虚空蠕虫"
	task.67AB7E57F0548C2C.title: "任意 #elevatorid:elevators"
	task.69F7F61602435663.title: "击败&b滑块"
	task.6A64112F92690241.title: "点我！"
	task.6C6A449FB595E875.title: "击败&4先驱者"
	task.71C06FD3B2B127B3.title: "击败&b宝箱怪"
	task.7362BF4629FAD929.title: "保卫村庄"
	task.74C85348A8B837EB.title: "点我！"
	task.7597CAEB6D13ED0F.title: "收集任意&d龙蛋"
	task.760227D918F26D13.title: "造访&7银色地牢"
	task.78C390F75DC274B9.title: "击杀星辉碎裂者"
	task.7958828E29C1C167.title: "点我！"
	task.7FC5892104C0744C.title: "进入下界"
	chapter.0089409420222E85.title: " &4&l冰火传说"
	quest.70BA06CAD4839A18.title: "开采&f银矿"
	quest.70BA06CAD4839A18.quest_subtitle: "冰火传说的一切都从&f银&r开始。银矿散布在主世界地下，和铁矿差不多深。"
	quest.45EE2D6787C5272E.title: "收集&f龙之骨"
	quest.45EE2D6787C5272E.quest_subtitle: "沙漠和雪原地下埋着巨龙的尸骸，挖开就有。不必先杀龙。"
	quest.253E8EFC65E99A4B.title: "打造&a龙鳞头盔"
	quest.253E8EFC65E99A4B.quest_subtitle: "龙鳞比钻石更硬。颜色取决于你剥的是哪条龙。"
	quest.3891EEBC185E86FB.title: "打造&f龙骨剑"
	quest.3891EEBC185E86FB.quest_subtitle: "屠龙的第一把像样的武器。往下所有的路都从它开始。"
	quest.1B32CB344D10B93D.title: "击杀&4火龙"
	quest.1B32CB344D10B93D.quest_subtitle: "住在沙漠和平原的巢穴里。先打幼龙，成年火龙一口火就能把你烧成灰。"
	quest.1BD6D69FB77BBE6F.title: "击杀&b冰龙"
	quest.1BD6D69FB77BBE6F.quest_subtitle: "雪原和冰原的主人。它的吐息会直接冻结你，穿好抗寒的装备。"
	quest.374F7B38E576E57E.title: "击杀&d电龙"
	quest.374F7B38E576E57E.quest_subtitle: "热带草原上空的雷霆。三条龙里飞得最快，最好用弓。"
	quest.2BE974B27F759D33.title: "取得&4火龙心脏"
	quest.2BE974B27F759D33.quest_subtitle: "只有&l成年&r火龙才会掉落。幼龙没有。"
	quest.33C7B9CF1B7B11D9.title: "取得&b冰龙心脏"
	quest.33C7B9CF1B7B11D9.quest_subtitle: "同样只有成年冰龙才掉。"
	quest.6F8692B395D1D7E6.title: "取得&d电龙心脏"
	quest.6F8692B395D1D7E6.quest_subtitle: "同样只有成年电龙才掉。"
	quest.2AF653E2E01B9277.title: "炼制&4龙炎钢锭"
	quest.2AF653E2E01B9277.quest_subtitle: "把火龙心脏和下界合金锭放进熔炉。这是冰火传说里最强的一档材料。"
	quest.177F7813F164769B.title: "炼制&b龙霜钢锭"
	quest.177F7813F164769B.quest_subtitle: "用冰龙心脏炼。三种龙钢属性相同，看你喜欢哪个颜色。"
	quest.6831662B9392A997.title: "炼制&d龙霆钢锭"
	quest.6831662B9392A997.quest_subtitle: "用电龙心脏炼。"
	quest.0A59D9DD126A6ED7.title: "打造&4龙炎钢剑"
	quest.0A59D9DD126A6ED7.quest_subtitle: "伤害超过下界合金剑，还附带点燃效果。"
	quest.17B2A78920EF73A5.title: "打造&b龙霜钢剑"
	quest.17B2A78920EF73A5.quest_subtitle: "命中会冻结目标。"
	quest.1367BE6AA855370B.title: "打造&d龙霆钢剑"
	quest.1367BE6AA855370B.quest_subtitle: "命中会引下闪电。"
	quest.5FD97CE01DA3E367.title: "穿上&4龙炎钢胸甲"
	quest.5FD97CE01DA3E367.quest_subtitle: "整套龙钢甲免疫对应属性的龙息。这是本章的终点装备。"
	quest.55DFE2589E2220DA.title: "击败&e独眼巨人"
	quest.55DFE2589E2220DA.quest_subtitle: "海边洞穴里的巨人，会把你抓起来吃掉。打它的眼睛。"
	quest.19A3CD1287D87EE5.title: "击败&3海蟒"
	quest.19A3CD1287D87EE5.quest_subtitle: "深海里的巨蟒。它会把你拖进水里淹死，带好水下呼吸。"
	quest.5C543D129490E258.title: "击败&2蛇发女妖"
	quest.5C543D129490E258.quest_subtitle: "&l千万别和她对视&r——会被直接石化。背对着走，或者用盾。"
	quest.4A9634FC8035A47A.title: "击败&6死亡蠕虫"
	quest.4A9634FC8035A47A.quest_subtitle: "沙漠地下的伏击者。它会从沙子里窜出来把你吞掉。"
	quest.3196794EFD387D85.title: "击败&5九头蛇"
	quest.3196794EFD387D85.quest_subtitle: "沼泽洞穴里的九头蛇。砍掉一个头会长回两个，得用火烧断口。"
	quest.32156DD7648B252C.title: "击败&8&l悚怖尸巫"
	quest.32156DD7648B252C.quest_subtitle: "出没在悚怖陵墓一带的亡灵法师，会召唤亡灵帮手、发射冰魂髑髅。带上你能拿出的最好的装备。"
	quest.32156DD7648B252C.quest_desc: ["它会不停召唤亡灵围攻你，建议先清掉周围的小怪再集火本体，否则你会被数量淹没。", "", "击败它有机会掉落悚怖碎片和悚怖钥匙。", "击败它之后，冰火传说这一章就算通关了。"]
	chapter.7EEB8A1EC9332A30.title: " &6&l农事"
	quest.35C47BE311D47C8F.title: "打一把&f燧石刀"
	quest.35C47BE311D47C8F.quest_subtitle: "农夫乐事的一切从刀开始。有了它才能在砧板上切东西。"
	quest.50E86C2C5F2CA963.title: "架起&6砧板"
	quest.50E86C2C5F2CA963.quest_subtitle: "把刀放在砧板上右键，就能把食材切成更有用的形态。原木切木板出材率更高。"
	quest.5310F88053FC3FCD.title: "支起&c厨锅"
	quest.5310F88053FC3FCD.quest_subtitle: "本模组的核心。下面垫热源就能炖汤，记得在旁边放碗。"
	quest.574487031B14FE25.title: "垒一座&6炉灶"
	quest.574487031B14FE25.quest_subtitle: "能同时煎六份食物，还能当厨锅的热源。厨房的中心。"
	quest.689CFA9207AF157D.title: "打一口&7煎锅"
	quest.689CFA9207AF157D.quest_subtitle: "可以拿在手上边走边煎，也能当武器抡。"
	quest.1FF7BA164FA651F0.title: "沤一堆&2有机堆肥"
	quest.1FF7BA164FA651F0.quest_subtitle: "把烂掉的食材扔进去别浪费。"
	quest.5D4CB16357B0DF96.title: "改良出&2沃土"
	quest.5D4CB16357B0DF96.quest_subtitle: "沃土上的作物长得更快，而且&l不需要浇水&r。"
	quest.5F969F1A6E7C618C.title: "升级到&f铁刀"
	quest.5F969F1A6E7C618C.quest_subtitle: "更耐用，切肉更快。"
	quest.2C633687247FAAA1.title: "磨出&e面粉"
	quest.2C633687247FAAA1.quest_subtitle: "沉浸农艺的起点。小麦磨成面粉，面粉才能做正经吃的。"
	quest.712B7B3690E6D9E5.title: "和一团&e面团"
	quest.712B7B3690E6D9E5.quest_subtitle: "面粉加水。面包、披萨、意面都从这儿来。"
	quest.16684B2258168D17.title: "沉浸农艺的&c烹饪锅"
	quest.16684B2258168D17.quest_subtitle: "和农夫乐事的厨锅是两套系统，菜谱不通用，两个都值得有。"
	quest.1F4AEFBB6E04F477.title: "沉浸农艺的&7烘焙机"
	quest.1F4AEFBB6E04F477.quest_subtitle: "煎蛋、煎肉、摊饼都靠它。"
	quest.29FA283962C00EED.title: "种出&6芒果"
	quest.29FA283962C00EED.quest_subtitle: "果园乐事的水果长在树上，去热带群系找树苗。"
	quest.6A647AD0E6F77C9F.title: "炖一碗&b冰糖雪梨"
	quest.6A647AD0E6F77C9F.quest_subtitle: "润喉的甜品。果园乐事里最有中式风味的一道。"
	quest.54400DF255CE3A0B.title: "烤一个&e菠萝派"
	quest.54400DF255CE3A0B.quest_subtitle: "整章水果线的收尾。"
	quest.64DF17A9F8AFCAAD.title: "做出&e奶酪块"
	quest.64DF17A9F8AFCAAD.quest_subtitle: "额外乐事的招牌。牛奶发酵成奶酪，能吃也能当建筑材料。"
	quest.1DBC4042680E971B.title: "烤一个&f奶酪蛋糕"
	quest.1DBC4042680E971B.quest_subtitle: "额外乐事有十几种口味的奶酪蛋糕，这只是第一个。"
	quest.79CA4EB8D7BE0450.title: "支起&6案板"
	quest.79CA4EB8D7BE0450.quest_subtitle: "屠宰工艺的入口。整只牲畜在这里被分解成各个部位。"
	quest.7DBE30B06B7DA642.title: "装一台&7绞肉机"
	quest.7DBE30B06B7DA642.quest_subtitle: "把肉绞成肉馅，香肠、肉丸都要用。"
	quest.6F6D08A5C036430B.title: "挂起&8肉钩"
	quest.6F6D08A5C036430B.quest_subtitle: "风干和熟成要用。挂得越久风味越好。"
	quest.3D66CF25D3E518D0.title: "造一台&6苹果压榨器"
	quest.3D66CF25D3E518D0.quest_subtitle: "葡萄酒香的起手式。先榨汁，才能酿酒。"
	quest.597F4E92309840B2.title: "酿一瓶&c苹果葡萄酒"
	quest.597F4E92309840B2.quest_subtitle: "发酵需要时间，别急着开瓶。酒也能放进储酒柜当装饰。"
	quest.3A3ED672E58FA6B3.title: "带回&4爆弹椒"
	quest.3A3ED672E58FA6B3.quest_subtitle: "下界乐事的辣椒，长在绯红森林。吃了会喷火，字面意义上的。"
	quest.24188CD410524577.title: "烤一个&5紫颂派"
	quest.24188CD410524577.quest_subtitle: "末影乐事。用末地的紫颂果做的甜品，吃完可能会随机传送。"
	quest.236FEC6BEAF7367A.title: "打一把&a铁木刀"
	quest.236FEC6BEAF7367A.quest_subtitle: "暮色乐事的厨刀，用暮色森林的铁木打造。"
	quest.7CD6A24ADBE208F4.title: "炖一锅&3守卫者浓汤"
	quest.7CD6A24ADBE208F4.quest_subtitle: "海洋乐事的终点菜。材料得从海底神殿里抢。"
	quest.7CD6A24ADBE208F4.quest_desc: ["守卫者和远古守卫者在农夫乐事这套系统里也是食材。", "", "先把海底神殿清干净，再回厨房慢慢炖。这是本章最难拿的一道菜。"]
	chapter.59165A3DAA4028F5.title: " &8&l永恒枪械"
	quest.04E5F5AB6A45AB1D.title: "搭起&7枪械工作台"
	quest.04E5F5AB6A45AB1D.quest_subtitle: "永恒枪械的一切都在这张台子上完成。枪、弹药、配件全靠它，工作台本身用铁和原木就能做。"
	quest.04E5F5AB6A45AB1D.quest_desc: ["这套枪械是&l数据驱动&r的：枪不是合成出来的，而是在工作台里按配方\"打造\"。", "", "打开工作台会看到三个页签——枪械、弹药、配件。左边列出所有可造的东西，右边告诉你缺什么材料。"]
	quest.6D19E1E934D8AB25.title: "造出你的&e第一把枪"
	quest.6D19E1E934D8AB25.quest_subtitle: "在工作台里挑一把造出来就算完成，不限型号。手枪最便宜，格洛克 17 或 M1911 都是不错的开局。"
	quest.6D19E1E934D8AB25.quest_desc: ["默认枪包里有 54 把枪：手枪、冲锋枪、突击步枪、霰弹枪、狙击步枪、机枪，还有 RPG-7 火箭筒。", "", "便宜的手枪十几个铁锭就能造，AKM 这类突击步枪要 38 铁锭 + 6 青金石 + 10 原木。先造把手枪练手。"]
	quest.18D1C758CA68326F.title: "备足&6弹药"
	quest.18D1C758CA68326F.quest_subtitle: "枪没子弹就是烧火棍。弹药按口径分，造之前先看清你的枪吃哪种。"
	quest.463972C982D1CFD3.title: "做一个&f弹药盒"
	quest.463972C982D1CFD3.quest_subtitle: "弹药盒能囤大量同口径子弹，出门带一个比带一堆弹匣省格子。"
	quest.32A36E23DC93C4B8.title: "装上第一个&b配件"
	quest.32A36E23DC93C4B8.quest_subtitle: "瞄具、握把、枪口、弹匣四类。在工作台里造好后，按住改装键装到枪上。"
	quest.7993603545066734.title: "配齐&b瞄准镜"
	quest.7993603545066734.quest_subtitle: "红点、全息、各种倍率的狙击镜。造三个不同的，按场合换。"
	quest.70CDA86026F5D2EB.title: "囤够&b扩容弹匣"
	quest.70CDA86026F5D2EB.quest_subtitle: "一级到三级扩容弹匣，载弹量翻倍。打 BOSS 前记得换上。"
	quest.5EBC22CF7E047101.title: "立一个&6人形标靶"
	quest.5EBC22CF7E047101.quest_subtitle: "打中会报伤害数字，用来测枪的威力和后坐力，别拿队友试枪。"
	quest.061E487C72B395E4.title: "做一辆&6标靶车"
	quest.061E487C72B395E4.quest_subtitle: "会跑的靶子。铺一圈轨道就是移动靶训练场。"
	quest.349E312692B11764.title: "囤够&f铁锭"
	quest.349E312692B11764.quest_subtitle: "枪械是吃铁大户，一把步枪就要三十多个铁锭。先屯一箱再开始。"
	quest.44AEADDDB0A3FF17.title: "囤够&9青金石"
	quest.44AEADDDB0A3FF17.quest_subtitle: "中高级枪械的必需材料，别只顾着拿来附魔。"
	quest.2920A55E6AFA2798.title: "囤够&6铜锭"
	quest.2920A55E6AFA2798.quest_subtitle: "弹药的主要消耗品。子弹打出去就没了，铜要持续产出。"
	quest.0AF861E6F6C1B4C3.title: "用枪清理&2僵尸"
	quest.0AF861E6F6C1B4C3.quest_subtitle: "拿新枪开个张。近距离别恋战，这套枪械的后坐力是真的。"
	quest.3DCD46D58351987E.title: "用枪对付&f骷髅"
	quest.3DCD46D58351987E.quest_subtitle: "远距离目标，正好试试你的瞄准镜。"
	quest.17418C9F2D8E9AE5.title: "用枪击败&1&l监守者"
	quest.17418C9F2D8E9AE5.quest_subtitle: "全副武装之后的终极考验。"
	quest.17418C9F2D8E9AE5.quest_desc: ["监守者血厚、免疫击退、听声辨位——但它挡不住子弹。", "", "带上大口径枪械、扩容弹匣和足够的备弹，找个它够不着的位置。记住它是靠震动找你的，开枪本身就会暴露位置。", "", "这是本章的终点。"]
	chapter.74F362CC26DF3C90.title: " &d&l新帕斯特之梦"
	quest.36C23AC28DF272B3.title: "&d帕斯特之梦"
	quest.36C23AC28DF272B3.quest_subtitle: "一场从主世界的裂隙开始、一层层往深处走的梦。"
	quest.36C23AC28DF272B3.quest_desc: [
		"帕斯特之梦有这几层梦境："
		"&d染梦世界&r：第 0 层梦境，粉色调，不生成怪物，一切从这里开始。"
		"&8灯影之下&r：第 1 层梦境，漆黑，敌对生物很多，要靠笔记残页一步步推进。"
		"&b风之旅途&r：和灯影之下平行的梦境，以浮空岛为主，需要滞空或飞行手段。"
		"&c亚伦柯斯竞技场&r：灯影之下的最终挑战，进去后不能破坏和放置方块。"
		""
		"两个贯穿全程的机制："
		"&e精神值&r：在染梦世界会上升；主世界的黄昏和夜晚、灯影之下、竞技场里会下降。精神值高有增益，低了有负面效果，甚至会看到异常。吃凤梨爱情海、戴花环、晚上睡觉都能恢复。"
		"&e融梦能量&r：部分武器战技和强征传送塔要消耗它，潜行时左下角能看到数值。戴融梦光环戒指、吃染梦冰棒、喝染梦果汁都能回复，开启融梦水晶箱也会回复 2 点。"
		""
		"点一下任务里的勾就能完成，开始寻梦。"
	]
	quest.751293BDCE3502F1.title: "染梦裂隙"
	quest.751293BDCE3502F1.quest_subtitle: "在主世界找到染梦裂隙并触碰它，然后去睡一觉。"
	quest.751293BDCE3502F1.quest_desc: [
		"醒来时裂隙会与你的梦境共鸣，你会得到一本寻梦者笔记【染梦裂隙】，读一读它。"
	]
	quest.7FB562E9AA2AD7B2.title: "太陽とレインボー"
	quest.7FB562E9AA2AD7B2.quest_subtitle: "制作一把园艺钳"
	quest.19DD835F1077175A.title: "下午茶时光"
	quest.19DD835F1077175A.quest_subtitle: "制作研究台以开展研究"
	quest.19DD835F1077175A.quest_desc: [
		"在灯影之下捡到的笔记残页，要在研究台上研究，才能做出完整的笔记。"
	]
	quest.1FD95D17B9A06839.title: "纯洁无瑕"
	quest.1FD95D17B9A06839.quest_subtitle: "采集一朵苍白雪莲"
	quest.3A119AF0A0DF6098.title: "哦！痛！"
	quest.3A119AF0A0DF6098.quest_subtitle: "使用苍白骨针在梦境中醒来"
	quest.3A119AF0A0DF6098.quest_desc: [
		"进入灯影之下时会给你一根苍白骨针，用它就能离开梦境、回到主世界。"
	]
	quest.3C8C715F2F1EC113.title: "哥德堡安眠曲"
	quest.3C8C715F2F1EC113.quest_subtitle: "穿过染梦裂隙，进入染梦世界。"
	quest.3C8C715F2F1EC113.quest_desc: [
		"染梦世界是第 0 层梦境，不生成怪物，也没有陷阱。"
		"在半空中找黑白相间的&f浸染教堂&r：里面的笔记记着主世界的一个特殊坐标，去那里能得到更多线索。"
		"结构里的&d融梦水晶箱&r能开出&d融梦水晶碎片&r，是后面的重要材料。"
	]
	quest.3783EC73D3AC1426.title: "把梦捧在手心里!"
	quest.3783EC73D3AC1426.quest_subtitle: "在染梦世界收集&d染梦粉尘&r。"
	quest.4CCF56BF56D2C66C.title: "熔融于梦"
	quest.4CCF56BF56D2C66C.quest_subtitle: "收集到一颗融梦水晶碎片"
	quest.4CCF56BF56D2C66C.quest_desc: [
		"染梦世界结构里的&d融梦水晶箱&r能开出来。"
	]
	quest.3241DD7C0BDA8243.title: "好梦在何方"
	quest.3241DD7C0BDA8243.quest_subtitle: "制作并饮用梦境果汁，在睡梦中前往染梦之境"
	quest.179394530C02E187.title: "不可食用果冻"
	quest.179394530C02E187.quest_subtitle: "制作并使用衍梦肥泥挥洒梦境的土地"
	quest.361844F121572A37.title: "尘埃落定"
	quest.361844F121572A37.quest_subtitle: "使用蓄梦池收集染梦粉尘"
	quest.0D05A3CB4902B3D4.title: "百味杂陈"
	quest.0D05A3CB4902B3D4.quest_subtitle: "获得一桶融梦涌泉"
	quest.110D6AEBB80C1378.title: "染梦宝藏"
	quest.110D6AEBB80C1378.quest_subtitle: "开启位于染梦世界的融梦水晶箱"
	quest.6FCB16F6B07D16A0.title: "日食遗物"
	quest.6FCB16F6B07D16A0.quest_subtitle: "获得断裂英雄剑"
	quest.768CF2E49E99720A.title: "在这里不是手电筒"
	quest.768CF2E49E99720A.quest_subtitle: "锻造出大地之刃"
	quest.7B5FEC3108472B09.title: "为什么不试试泰拉瑞亚呢"
	quest.7B5FEC3108472B09.quest_subtitle: "获得泰拉浮岛模型"
	quest.57F6504228D28D4B.title: "都说了要把能力点成平均值"
	quest.57F6504228D28D4B.quest_subtitle: "获得万象神戒"
	quest.5E3233D3371461B1.title: "我恨你是个木头！"
	quest.5E3233D3371461B1.quest_subtitle: "获得塞西莉娅的加护"
	quest.7674D4AB5EA0571B.title: "实妹相伴"
	quest.7674D4AB5EA0571B.quest_subtitle: "获得妃爱的蝴蝶结发夹"
	quest.55CA1F27591C66DA.title: "可爱即为正义！"
	quest.55CA1F27591C66DA.quest_subtitle: "获得娇小琴雨梦玩偶"
	quest.78A3471AEC47E771.title: "草莓甜心"
	quest.78A3471AEC47E771.quest_subtitle: "获得草莓甜心"
	quest.6A8372F857A195F1.title: "鱼儿如浩空繁星"
	quest.6A8372F857A195F1.quest_subtitle: "获得占星者的祈愿"
	quest.4E41391710F76A1F.title: "灯影之下"
	quest.4E41391710F76A1F.quest_subtitle: "睡进暮影长床，进入第二层梦境「灯影之下」。"
	quest.4E41391710F76A1F.quest_desc: [
		"在主世界的&8暮影之笼&r结构里完成「据点守卫」事件后，就能用那里的暮影长床进入灯影之下；之后也可以自己做暮影长床。"
		"灯影之下漆黑一片，敌对生物很多，精神值会持续下降，记得带上回复精神值的食物。"
		"进入时会给你一根&f苍白骨针&r，用它可以回到主世界。"
	]
	quest.6E62BA6B375895B9.title: "浸影回忆"
	quest.6E62BA6B375895B9.quest_subtitle: "获得一张灯影之下梦境的笔记残片"
	quest.6E62BA6B375895B9.quest_desc: [
		"灯影之下的生物和遗迹里都能找到。"
	]
	quest.2F96049ED68213C1.title: "于影共眠"
	quest.2F96049ED68213C1.quest_subtitle: "利用自制的暮影长床前往灯影"
	quest.75DF858670BDBEE2.title: "0.0.0 巧克力"
	quest.75DF858670BDBEE2.quest_subtitle: "制作并获得黑金属"
	quest.55F314CF7F2B5EB9.title: "暗影之地的觉醒"
	quest.55F314CF7F2B5EB9.quest_subtitle: "开始探索暗影之地"
	quest.0745A24CCED63292.title: "进入亚伦柯斯竞技场的资格"
	quest.0745A24CCED63292.quest_subtitle: "完成暗影之地的所有前置任务"
	quest.0745A24CCED63292.quest_desc: [
		"亚伦柯斯竞技场的入口结构自然生成在灯影之下的&8阴影之地&r生物群系里。"
	]
	quest.333E8B058C948772.title: "信仰光明"
	quest.333E8B058C948772.quest_subtitle: "在灯与影的选择中选择光明"
	quest.333E8B058C948772.quest_desc: [
		"灯与影只能选一边。"
	]
	quest.1D17A1B63194F0ED.title: "暗影仆从"
	quest.1D17A1B63194F0ED.quest_subtitle: "在灯与影的抉择中选择暗影"
	quest.1D17A1B63194F0ED.quest_desc: [
		"灯与影只能选一边。"
	]
	quest.1F0C19C80EA8D5D8.title: "吹影镂尘"
	quest.1F0C19C80EA8D5D8.quest_subtitle: "击败亚伦柯斯之触"
	quest.1F0C19C80EA8D5D8.quest_desc: [
		"进入竞技场后会被禁止改造（不能破坏和放置方块），同时获得缓降，装备提前准备好。"
	]
	quest.6ADD69F4A14A65E0.title: "&b风之旅途"
	quest.6ADD69F4A14A65E0.quest_subtitle: "喝下奇异炖菜，飞到主世界 Y 300 以上的高空。"
	quest.6ADD69F4A14A65E0.quest_desc: [
		"前置：读过寻梦者笔记【染梦裂隙】、【染梦世界】，以及在染梦世界的&b萦风教堂&r找到的【无翼鸟也有展翅的梦】。"
		"满足后回到主世界，吃&e奇异炖菜&r获得迷梦状态，一路往上飞到 Y 300 以上，会被云雾包裹、直接送到风之旅途的高空。"
		"这里以浮空岛为主，要准备滞空或飞行手段；掉进虚空就会回到主世界的高空。"
		"苍青岩层里有稀少的&b风行者水晶矿&r（至少要钻石镐）；厚重云朵层里有&f凝结之风云矿&r（徒手可挖，时运有效）。"
	]
	quest.1F88E56A58423407.title: "风旅宝藏"
	quest.1F88E56A58423407.quest_subtitle: "开启位于风之旅途的融梦水晶箱"
	quest.2747B030B1C031B0.title: "啵啵鸡之梦"
	quest.2747B030B1C031B0.quest_subtitle: "获得啵啵鸡的华丽飞羽"
	quest.4B8F9FAC6035177C.title: "匠人之心"
	quest.4B8F9FAC6035177C.quest_subtitle: "搭建并使用精铸工坊"
	quest.79343559FA815623.title: "真金不怕火炼"
	quest.79343559FA815623.quest_subtitle: "冶炼出一块炙焰金锭"
	quest.4F3D6326951FA558.title: "空间折跃"
	quest.4F3D6326951FA558.quest_subtitle: "制作一个强征传送塔"
	quest.4F3D6326951FA558.quest_desc: [
		"强征传送塔使用时要消耗融梦能量。"
	]
	quest.5BF054960D7E3AD1.title: "观星者"
	quest.5BF054960D7E3AD1.quest_subtitle: "用望远镜对准夜空中的星座星点"
	quest.6DD40DAFDDC8424D.title: "星语占卜师"
	quest.6DD40DAFDDC8424D.quest_subtitle: "对准天体使用羽星占卜图录，完成一次占卜"
	quest.2CC7006CFF60D43C.title: "织星者"
	quest.2CC7006CFF60D43C.quest_subtitle: "用星空枕在夜空上创建第一颗连线星体"
	quest.343FBEFEF1B9AA60.title: "你在做什么？"
	quest.343FBEFEF1B9AA60.quest_subtitle: "在满生命值状态下使用对立卡牌致使死亡。"
	chapter.3B02F981DC1D8908.title: " &6&l机械动力"
	quest.377ADF0DD3609FAD.title: "&6机械动力"
	quest.377ADF0DD3609FAD.quest_subtitle: "用齿轮、传动杆和传送带搭起自己的工厂。"
	quest.377ADF0DD3609FAD.quest_desc: [
		"机械动力的核心是&e旋转动力&r：水车、风车、蒸汽引擎和手摇曲柄产生动力，传动杆、齿轮和传送带把它传到机器上。"
		""
		"每台机器运转都要消耗&e应力&r，动力源能提供的应力有上限，超出上限整个网络就会停转。戴上&e工程师护目镜&r看机器，能看到转速和应力。"
		""
		"[\"\",{\"text\":\"不知道一个方块怎么用？把鼠标移到它上面，按住 \"},{\"keybind\":\"key.ponder.ponder\",\"color\":\"aqua\"},{\"text\":\" 进入「思索」，会播放这个方块的动画教程。\"}]"
		""
		"下面的任务会在你完成机械动力对应的进度时自动完成。最下面两排是可选的挑战。"
	]
	quest.1AA154AB42B238D6.title: "欢迎来到机械动力"
	quest.1AA154AB42B238D6.quest_subtitle: "匠工巧械由此开始"
	quest.1498CA81913F47D2.title: "坚如磐石"
	quest.1498CA81913F47D2.quest_subtitle: "获取机械动力中最重要的资源——安山合金"
	quest.1498CA81913F47D2.quest_desc: [
		"安山合金可以直接在工作台用安山岩和铁粒（或锌粒）合成，有了搅拌器以后可以批量做。几乎所有初期机器都要用到它。"
	]
	quest.3C88560D0AE04AE2.title: "安山时代"
	quest.3C88560D0AE04AE2.quest_subtitle: "对去皮原木使用安山合金，为你的机器制作一个基础的机壳"
	quest.05BC8265922EAC95.title: "铿！"
	quest.05BC8265922EAC95.quest_subtitle: "使用动力冲压机制作一些板材"
	quest.3B7BD2AEEACD48BF.title: "驭风者"
	quest.3B7BD2AEEACD48BF.quest_subtitle: "放置一个鼓风机并为其供能"
	quest.2AB43A5A42AEE881.title: "粒子加工"
	quest.2AB43A5A42AEE881.quest_subtitle: "使用鼓风机加工材料"
	quest.6E41ACCD296B9A11.title: "车间中的骇人机械"
	quest.6E41ACCD296B9A11.quest_subtitle: "使用正面朝上的动力锯来加工材料"
	quest.3127D26DD9BC8A54.title: "河动力"
	quest.3127D26DD9BC8A54.quest_subtitle: "放置一个水车并让它产生旋转力"
	quest.2D547A86345291C5.title: "微风吹拂"
	quest.2D547A86345291C5.quest_subtitle: "组装风车并使其产生动力"
	quest.40BAFDBF746D4DE4.title: "换挡，加速，起飞！"
	quest.40BAFDBF746D4DE4.quest_subtitle: "将大齿轮连接到小齿轮上，从而改变结构的转速"
	quest.08595115D96A5C03.title: "怡人磨练"
	quest.08595115D96A5C03.quest_subtitle: "使用石磨将物品磨碎"
	quest.2EDB342BDE41978A.title: "衔接地带"
	quest.2EDB342BDE41978A.quest_subtitle: "使用强力胶将多个方块连为一体"
	quest.5E0518E7B354AED7.title: "有的放驶"
	quest.5E0518E7B354AED7.quest_subtitle: "创建一个带有动力钻头、动力锯或者动力收割机的动态结构"
	quest.36856D6A6044B77E.title: "顺道交换"
	quest.36856D6A6044B77E.quest_subtitle: "使用移动式存储接口从动态结构中取出或输入物品"
	quest.31B2D5EF612A4367.title: "一应俱全"
	quest.31B2D5EF612A4367.quest_subtitle: "同时装备工程师护目镜与扳手"
	quest.6B067966F807FBE7.title: "应力数是给呆子看的"
	quest.6B067966F807FBE7.quest_subtitle: "在应力表和工程师护目镜的辅助下获取准确读数"
	quest.6D6AC51A9E5ACF71.title: "到点了吗？"
	quest.6D6AC51A9E5ACF71.quest_subtitle: "目睹你的布谷鸟闹钟提醒就寝时刻"
	quest.765DEECD9E2EB06C.title: "压缩文件"
