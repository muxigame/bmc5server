	quest.5BCF9D61C52EABCC.title: "合成&6存储终端"
	quest.5C7D3880C410D7DB.quest_subtitle: "要做&f吊床&r，先合成&f吊床布&r，再合成两个&2绳索与钉子&r。把两个&2绳索与钉子&r相隔四格放好，中间挂上&f吊床布&r即可。"
	quest.5C7D3880C410D7DB.title: "合成&f&l吊床"
