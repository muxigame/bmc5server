	chapter.21B5FD461C6FB23C.title: " &c&lTouhou Little Maid"
	quest.00A3F0BB3E83ED7D.title: "&cTouhou Little Maid"
	quest.00A3F0BB3E83ED7D.quest_subtitle: "Summon a maid to farm, fight and look after your home."
	quest.00A3F0BB3E83ED7D.quest_desc: [
		"Everything in Touhou Little Maid starts with the &eGohei&r: craft one, then build the &eAltar&r. Maids are summoned from the altar."
		""
		"&eMaid Fairies&r spawn at night in any biome and fly around shooting danmaku at players and iron golems. Defeating them drops &ePower Points&r. While holding a Gohei your Power is shown in the top-left corner (5 at most); altar crafting consumes it."
		""
		"Every altar recipe can be looked up in JEI."
	]
	quest.42A8294BEC0C3890.title: "The Key to Gensou?"
	quest.42A8294BEC0C3890.quest_subtitle: "Craft a gohei"
	quest.42A8294BEC0C3890.quest_desc: [
		"The Gohei is a melee weapon; a maid holding one fires danmaku in danmaku mode. It is also the tool that forms the altar."
	]
	quest.3DA3895414DCD6C5.title: "Construction Complete"
	quest.3DA3895414DCD6C5.quest_subtitle: "Build an altar, and let the fun begin"
	quest.3DA3895414DCD6C5.quest_desc: [
		"{image:touhou_little_maid:textures/book/altar.png width:150 height:150 align:center}"
		"Layout: six 3-high &eOak Log&r pillars in a ring, with a &cred wool&r torii on one side of the ring: two 3-high legs, a 6-wide beam on top of them, one block above each leg, and another 6-wide beam on top."
		""
		"Right-click the front of the red wool &eleft of centre on the lower beam&r with the Gohei. If the structure is right it turns into the altar."
		""
		"Use: right-click the top of a pillar to place an item, sneak-right-click with an empty hand to take it back. Once all items are in place and you have enough Power the craft starts; if it stopped for lack of Power, right-click again after collecting more."
	]
	quest.44223C78896877D7.title: "Annoying Little Faes"
	quest.44223C78896877D7.quest_subtitle: "Kill a maid fairy"
	quest.39AC91707AE15EFD.title: "Taste the Rainbow"
	quest.39AC91707AE15EFD.quest_subtitle: "Pickup the power point"
	quest.790F6FC19A7018CE.title: "A New Life"
	quest.790F6FC19A7018CE.quest_subtitle: "Summon a maid from the altar"
	quest.790F6FC19A7018CE.quest_desc: [
		"Craft the &eCake Box&r with a maid inside at the altar (see JEI for the recipe). Right-click it three times to open it fully and the maid comes out."
	]
	quest.75900BFE80E9A30C.title: "Welcome Home, Master"
	quest.75900BFE80E9A30C.quest_subtitle: "Tame a maid with a cake, I know they love sweets"
	quest.75900BFE80E9A30C.quest_desc: [
		"Right-click the maid with a cake to tame her. Once tamed, right-click her to open her screen."
		"By default she follows you and picks up nearby items, arrows, experience and Power Points; sneak-right-click her with an empty hand to toggle standby."
	]
	quest.763B58610980E36D.title: "Cosplay!"
	quest.763B58610980E36D.quest_subtitle: "Switch maid skins"
