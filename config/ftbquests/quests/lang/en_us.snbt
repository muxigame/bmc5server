	quest.4DD656796F6A366D.quest_subtitle: "Toggle the maid's task"
	quest.4DD656796F6A366D.quest_desc: [
		"Use the work mode button in her screen to choose a job: farming, fishing, fighting, feeding animals and more. The schedule button sets when she works, rests and sleeps."
		"Press the Home button and she remembers the spot and stays within 12 blocks of it."
	]
