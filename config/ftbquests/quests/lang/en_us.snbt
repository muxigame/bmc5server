	chapter.3B02F981DC1D8908.title: " &6&lCreate"
	quest.377ADF0DD3609FAD.title: "&6Create"
	quest.377ADF0DD3609FAD.quest_subtitle: "Build your own factory out of cogs, shafts and belts."
	quest.377ADF0DD3609FAD.quest_desc: [
		"Create runs on &erotational power&r: water wheels, windmills, steam engines and hand cranks generate it, and shafts, cogs and belts carry it to your machines."
		""
		"Every machine consumes &estress&r and every source only provides so much. Exceed the capacity and the whole network stops. Wear &eEngineer's Goggles&r to see speed and stress on machines."
		""
		"[\"\",{\"text\":\"Not sure how a block works? Hover over it and hold \"},{\"keybind\":\"key.ponder.ponder\",\"color\":\"aqua\"},{\"text\":\" to Ponder: an animated tutorial plays for that block.\"}]"
		""
		"The quests below complete automatically as you earn Create's advancements. The bottom two rows are optional challenges."
	]
	quest.1AA154AB42B238D6.title: "Welcome to Create"
	quest.1AA154AB42B238D6.quest_subtitle: "Here Be Contraptions"
	quest.1498CA81913F47D2.title: "Sturdier Rocks"
	quest.1498CA81913F47D2.quest_subtitle: "Obtain some Andesite Alloy, Create's most important resource"
	quest.1498CA81913F47D2.quest_desc: [
		"Craft Andesite Alloy from andesite and iron (or zinc) nuggets in a crafting table; once you have a mixer you can mass-produce it. Almost every early machine needs it."
	]
