	quest.768CF2E49E99720A.quest_subtitle: "Forge the Terra Sword"
	quest.7B5FEC3108472B09.title: "Why Not Try Terraria?"
	quest.7B5FEC3108472B09.quest_subtitle: "Obtain the Terra Charm"
	quest.57F6504228D28D4B.title: "I Told You to Balance Your Stats"
	quest.57F6504228D28D4B.quest_subtitle: "Obtain the Allkinds Ring"
	quest.5E3233D3371461B1.title: "I Hate That You're a Plank!"
	quest.5E3233D3371461B1.quest_subtitle: "Obtain Cecilia's Care"
	quest.7674D4AB5EA0571B.title: "A Real Sister by My Side"
	quest.7674D4AB5EA0571B.quest_subtitle: "Obtain Hiyori's Ribbon Hairpin"
	quest.55CA1F27591C66DA.title: "Cuteness Is Justice!"
	quest.55CA1F27591C66DA.quest_subtitle: "Obtain a Tiny Qin Yumeng Doll"
	quest.78A3471AEC47E771.title: "Strawberry Heart"
	quest.78A3471AEC47E771.quest_subtitle: "Obtain Strawberry Heart"
	quest.6A8372F857A195F1.title: "Fish Like Stars in the Vast Sky"
	quest.6A8372F857A195F1.quest_subtitle: "Obtain the Astrologer's Wish"
	quest.4E41391710F76A1F.title: "Achievement Shadow Start"
	quest.4E41391710F76A1F.quest_subtitle: "Sleep in a Shadow Bed to enter the second dream layer, Under the Lamp Shadow."
	quest.4E41391710F76A1F.quest_desc: [
		"Complete the Stronghold Guard event in a Twilight Cage structure in the Overworld; its Shadow Bed then takes you to Lamp Shadow. Afterwards you can craft your own Shadow Bed."
		"Lamp Shadow is dark and full of hostile mobs, and your sanity keeps dropping there. Bring food that restores sanity."
		"You receive a Pale Bone Needle on entry; use it to return to the Overworld."
	]
	quest.6E62BA6B375895B9.title: "Memories Soaked in Shadow"
	quest.6E62BA6B375895B9.quest_subtitle: "Obtain a note fragment from the Beneath Lamp & Shadow dream"
	quest.6E62BA6B375895B9.quest_desc: [
		"Dropped by mobs and found in ruins in Lamp Shadow."
	]
	quest.2F96049ED68213C1.title: "Sleeping with the Shadows"
	quest.2F96049ED68213C1.quest_subtitle: "Use a self-made Twilight Long Bed to reach Lamp Shadow"
	quest.75DF858670BDBEE2.title: "0.0.0 Chocolate"
	quest.75DF858670BDBEE2.quest_subtitle: "Obtain Black Metal"
	quest.55F314CF7F2B5EB9.title: "Awakening of the Shadow Realm"
	quest.55F314CF7F2B5EB9.quest_subtitle: "Begin exploring the Shadow Realm"
	quest.0745A24CCED63292.title: "Qualification for Aaroncos Arena"
	quest.0745A24CCED63292.quest_subtitle: "Complete all prerequisite tasks in the Shadow Realm"
	quest.0745A24CCED63292.quest_desc: [
		"The entrance structure of the Aaroncos Arena generates naturally in the Shadow Land biome of Lamp Shadow."
	]
	quest.333E8B058C948772.title: "Achievement Talent Light"
	quest.333E8B058C948772.quest_subtitle: "Choose the light between lamp and shadow"
	quest.333E8B058C948772.quest_desc: [
		"You can only choose one side: light or shadow."
	]
	quest.1D17A1B63194F0ED.title: "Achievement Talent Shadow"
	quest.1D17A1B63194F0ED.quest_subtitle: "Choose the shadow between lamp and shadow"
	quest.1D17A1B63194F0ED.quest_desc: [
		"You can only choose one side: light or shadow."
	]
	quest.1F0C19C80EA8D5D8.title: "Shadow Crafting"
	quest.1F0C19C80EA8D5D8.quest_subtitle: "Defeat Aaroncos's Touch"
	quest.1F0C19C80EA8D5D8.quest_desc: [
		"Inside the arena you cannot break or place blocks, and you get slow falling. Prepare your gear beforehand."
	]
	quest.6ADD69F4A14A65E0.title: "&bWind Journey"
	quest.6ADD69F4A14A65E0.quest_subtitle: "Eat Queer Soup and fly above Y 300 in the Overworld."
	quest.6ADD69F4A14A65E0.quest_desc: [
		"Prerequisites: read the notes [Dyedream Crack], [Dyedream World] and [Wingless Birds Dream of Flight], the last one found in the wind church in the Dyedream World."
		"Then return to the Overworld, eat Queer Soup to become dreamy, and fly above Y 300. The clouds wrap around you and carry you to the sky of the Wind Journey."
		"It is mostly floating islands, so bring a way to glide or fly. Falling into the void takes you back to the Overworld sky."
		"Rare Windrunner Crystal ore sits in the azure rock layer (diamond pickaxe or better); Congealed Wind ore sits in the thick cloud layer (mineable by hand, affected by Fortune)."
	]
	quest.1F88E56A58423407.title: "Achievement Treasure Wind Journey"
	quest.1F88E56A58423407.quest_subtitle: "Open a Meltdream Chest in the Wind's Journey"
