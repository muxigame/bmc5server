	chapter.2C36D58D07697AC2.title: " &5&lIron's Spells 'n Spellbooks"
	quest.7AA6614F2802A000.title: "&5Iron's Spells 'n Spellbooks"
	quest.7AA6614F2802A000.quest_subtitle: "Inscribe spells into a spellbook and cast them with mana."
	quest.7AA6614F2802A000.quest_desc: [
		"Spells live in &espellbooks&r: put a spellbook in the &espellbook accessory slot&r and you can cast the spells inside it. Casting uses &emana&r, which regenerates over time."
		""
		"Spells come from &escrolls&r: use a scroll directly for a one-off cast, or inscribe it into a spellbook at the &eInscription Table&r (the scroll is used up). Scrolls turn up in chests everywhere, and you can make your own at the &eScroll Forge&r from ink, paper and a focus item (the focus decides the school)."
		""
		"[\"\",{\"text\":\"Press \"},{\"keybind\":\"key.irons_spellbooks.spellbook_cast\",\"color\":\"aqua\"},{\"text\":\" to cast the selected spell; hold \"},{\"keybind\":\"key.irons_spellbooks.spell_wheel\",\"color\":\"aqua\"},{\"text\":\" to pick a spell from the wheel; hold \"},{\"keybind\":\"key.irons_spellbooks.spell_bar_modifier\",\"color\":\"aqua\"},{\"text\":\" and scroll the mouse wheel to switch spells on the spell bar.\"}]"
	]
