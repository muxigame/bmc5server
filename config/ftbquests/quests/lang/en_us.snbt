	chapter.74F362CC26DF3C90.title: " &d&lPaster Dream"
	quest.36C23AC28DF272B3.title: "&dPaster Dream"
	quest.36C23AC28DF272B3.quest_subtitle: "A dream that starts at a rift in the Overworld and goes deeper layer by layer."
	quest.36C23AC28DF272B3.quest_desc: [
		"Paster Dream has several dream layers:"
		"&dDyedream World&r: layer 0, pink and free of monsters. Everything starts here."
		"&8Under the Lamp Shadow&r: layer 1, dark and full of hostile mobs; you progress by collecting note fragments."
		"&bWind Journey&r: a dream parallel to Lamp Shadow, mostly floating islands; bring a way to glide or fly."
		"&cAaroncos Arena&r: the final challenge of Lamp Shadow; you cannot break or place blocks inside."
		""
		"Two mechanics run through the whole mod:"
		"&eSanity&r rises in the Dyedream World and drops at dusk and night in the Overworld, in Lamp Shadow and in the Arena. High sanity gives buffs, low sanity gives debuffs and strange sights. Pineapple Love Sea, garlands and sleeping at night restore it."
		"&eMeltdream Energy&r is spent by some weapon skills and the Forced Tower; sneak to see it in the bottom-left corner. Meltdream rings, Dyedream popsicles and Dyedream juice restore it, and opening a Meltdream crystal chest restores 2."
		""
		"Tick the checkmark to begin."
	]
	quest.751293BDCE3502F1.title: "Dyedream Rift"
	quest.751293BDCE3502F1.quest_subtitle: "Find a Dyedream Crack in the Overworld, touch it, then go to sleep."
	quest.751293BDCE3502F1.quest_desc: [
		"When you wake up the crack resonates with your dream and you receive the Dreamseeker's Notes [Dyedream Crack]. Read it."
	]
	quest.7FB562E9AA2AD7B2.title: "Achievement B1"
	quest.7FB562E9AA2AD7B2.quest_subtitle: "Craft a Pair of Pliers"
	quest.19DD835F1077175A.title: "Afternoon Tea"
	quest.19DD835F1077175A.quest_subtitle: "Craft a Research Table to begin your studies"
	quest.19DD835F1077175A.quest_desc: [
		"Note fragments found in Lamp Shadow have to be researched here before they become complete notes."
	]
	quest.1FD95D17B9A06839.title: "Achievement A1"
	quest.1FD95D17B9A06839.quest_subtitle: "Collect a Pale Snow Lotus"
	quest.3A119AF0A0DF6098.title: "Achievement B2"
	quest.3A119AF0A0DF6098.quest_subtitle: "Use a Pale Bone Needle to wake up in the dream"
	quest.3A119AF0A0DF6098.quest_desc: [
		"Entering Lamp Shadow gives you a Pale Bone Needle; use it to wake up and return to the Overworld."
	]
	quest.3C8C715F2F1EC113.title: "Achievement B0"
	quest.3C8C715F2F1EC113.quest_subtitle: "Go through the Dyedream Crack into the Dyedream World."
	quest.3C8C715F2F1EC113.quest_desc: [
		"The Dyedream World is dream layer 0: no monsters and no traps."
		"Look for the black-and-white church floating in the air. Its notes record a special coordinate in the Overworld; go there for more clues."
		"Meltdream crystal chests in structures contain Meltdream Crystal Shards, an important material later on."
	]
	quest.3783EC73D3AC1426.title: "Achievement C0"
	quest.3783EC73D3AC1426.quest_subtitle: "Collect &dDyedream Dust&r in the Dyedream World."
	quest.4CCF56BF56D2C66C.title: "Achievement D0"
	quest.4CCF56BF56D2C66C.quest_subtitle: "Collect a Meltdream Crystal Shard"
	quest.4CCF56BF56D2C66C.quest_desc: [
		"Found in Meltdream crystal chests in Dyedream World structures."
	]
	quest.3241DD7C0BDA8243.title: "Achievement C1"
	quest.3241DD7C0BDA8243.quest_subtitle: "Craft and drink Dream Juice to visit the Dyedream Realm in your sleep"
	quest.179394530C02E187.title: "Achievement C2"
	quest.179394530C02E187.quest_subtitle: "Craft and use Dream Fertilizer to till the dreamland soil"
	quest.361844F121572A37.title: "Achievement C3"
	quest.361844F121572A37.quest_subtitle: "Obtain and use a Dream Accumulator"
	quest.0D05A3CB4902B3D4.title: "A Taste of Everything"
	quest.0D05A3CB4902B3D4.quest_subtitle: "Obtain a bucket of Meltdream Spring"
	quest.110D6AEBB80C1378.title: "Achievement Treasure Dyedream"
	quest.110D6AEBB80C1378.quest_subtitle: "Open a Meltdream Chest in the Dyedream World"
	quest.6FCB16F6B07D16A0.title: "Eclipse Relic"
	quest.6FCB16F6B07D16A0.quest_subtitle: "Obtain the Broken Hero Sword"
